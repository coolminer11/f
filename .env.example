# --- Accès au back-office (pas d'authentification pour l'instant) -----------
# Mot de passe unique partagé par les deux associés.
BACKOFFICE_PASSWORD=

# Secret servant à signer le cookie de session (au moins 16 caractères).
SESSION_SECRET=

# --- Base de données --------------------------------------------------------
# Chaîne de connexion PostgreSQL du projet Supabase (Connection string →
# Transaction pooler). Elle donne un accès TOTAL à la base : jamais dans une
# variable NEXT_PUBLIC_, jamais dans un composant client, jamais dans un log.
DATABASE_URL=

# Mettre à false uniquement pour un PostgreSQL local sans TLS.
# DATABASE_SSL=false

# --- Entreposage des reçus (Supabase Storage) -------------------------------
# Sans ces deux variables, les reçus sont écrits dans ./recus-local : c'est un
# repli de développement, sans valeur en production.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
