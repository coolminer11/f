# --- Session --------------------------------------------------------------
# Secret servant à signer le cookie de session (au moins 16 caractères).
# Le changer déconnecte tout le monde.
SESSION_SECRET=

# --- Base de données --------------------------------------------------------
# Chaîne de connexion PostgreSQL du projet Supabase (Connection string →
# Transaction pooler). Elle donne un accès TOTAL à la base : jamais dans une
# variable NEXT_PUBLIC_, jamais dans un composant client, jamais dans un log.
DATABASE_URL=

# Mettre à false uniquement pour un PostgreSQL local sans TLS.
# DATABASE_SSL=false

# --- Envoi des documents par courriel ---------------------------------------
# Sans ces deux variables, les envois sont SIMULÉS : le message est écrit dans
# ./courriels-locaux et le journal des envois l'indique clairement.
# La clé se crée sur resend.com ; l'expéditeur doit appartenir à un domaine
# que vous y avez vérifié.
RESEND_API_KEY=
COURRIEL_EXPEDITEUR="Tapora S.E.N.C. <facturation@tapora.ca>"

# --- Entreposage des reçus (Supabase Storage) -------------------------------
# Sans ces deux variables, les reçus sont écrits dans ./recus-local : repli de
# développement, sans valeur en production.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
